{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "servers": {
      "figma-console": {
        "type": "local",
        "command": ["npx", "-y", "figma-console-mcp@latest"],
        "environment": {
          "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}",
          "ENABLE_MCP_APPS": "true"
        },
        "timeout": {
          "startup": 60000,
          "execution": 300000
        }
      }
    }
  }
}
