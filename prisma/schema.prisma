// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SensorReading {
  id          String   @id @default(uuid())
  moisture    Float
  temperature Float
  phLevel     Float?
  timestamp   DateTime @default(now())
  location    String?
}
